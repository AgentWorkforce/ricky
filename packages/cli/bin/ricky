#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"

if [ -f "$REPO_ROOT/dist/ricky.js" ]; then
  exec node "$REPO_ROOT/dist/ricky.js" "$@"
fi

exec "$REPO_ROOT/node_modules/.bin/tsx" "$REPO_ROOT/src/surfaces/cli/bin/ricky.ts" "$@"
