{
  "type": "object",
  "required": [
    "id",
    "webhookId",
    "type",
    "sessionId",
    "organizationId",
    "trigger",
    "actor",
    "issue",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "webhookId": { "type": "string" },
    "type": { "enum": ["created", "prompted"] },
    "sessionId": { "type": "string" },
    "organizationId": { "type": "string" },
    "trigger": { "enum": ["issue_mention", "comment_mention", "assignment"] },
    "actor": {
      "type": "object",
      "required": ["linearUserId"],
      "properties": {
        "linearUserId": { "type": "string", "minLength": 1 }
      }
    },
    "issue": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string" }
  }
}
